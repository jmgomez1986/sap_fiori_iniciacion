<mvc:View
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    controllerName="logaligroup.invoices.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <Panel
            id="panelSection"
            headerText="{i18n>selectionScreen}"
        >
            <FlexBox
                id="flexbox"
                height="100px"
                alignItems="Center"
                justifyContent="Start"
            >
                <Label
                    id="labelShipName"
                    labelFor="shipName"
                    text="{i18n>shipName}"
                    class="sapUiSmallMargin"
                />
                <Input
                    id="shipName"
                    value="{selectionScreen>/shipName}"
                    width="200px"
                    class="sapUiSmallMarginEnd"
                />
                <Label
                    id="labelCountry"
                    labelFor="country"
                    text="{i18n>country}"
                    class="sapUiSmallMargin"
                />
                <Select
                    id="slCountry"
                    selectedKey="{selectionScreen>/countryKey}"
                    forceSelection="false"
                    items="{selectionScreen>/countries}"
                >
                    <items>
                        <core:Item
                            id="item"
                            key="{selectionScreen>key}"
                            text="{selectionScreen>text}"
                        />
                    </items>
                </Select>
                <Button
                    id="buttonFilter"
                    text="{i18n>btnFilter}"
                    icon="sap-icon://filter"
                    press="onFilter"
                    class="sapUiSmallMarginEnd"
                />
                <Button
                    id="buttonClearFilter"
                    text="{i18n>btnClearFilters}"
                    icon="sap-icon://clear-filter"
                    press="onClearFilter"
                    class="sapUiSmallMarginEnd"
                />
            </FlexBox>
        </Panel>
    </Page>
</mvc:View>
